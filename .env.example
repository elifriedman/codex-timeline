# Required only when running the extractor with --summarize.
OPENAI_API_KEY=your_api_key_here

# Optional: leave unset to use the OpenAI SDK default. For an OpenAI-compatible
# service, set this to its API base, including the path such as /v1.
# OPENAI_BASE_URL=https://your-compatible-domain.example/v1
OPENAI_MODEL=gpt-5-mini

# Optional: lower this to force the user-message-only fallback sooner.
OPENAI_SUMMARY_MAX_CHARS=60000

# Optional: control parallel requests and retry count.
OPENAI_SUMMARY_WORKERS=4
OPENAI_SUMMARY_MAX_RETRIES=5
